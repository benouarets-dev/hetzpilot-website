{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hetzpilot-website",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "hetzpilot.benouarets.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "RELEASE": "inapplereview",
    "BREVO_LIST_ID": "9",
    "BREVO_DOI_TEMPLATE_ID": "8"
  },
  "secrets_store_secrets": [
    {
      "binding": "BREVO_API_KEY",
      "store_id": "fc23c113f2d348fc8a490811b68b5f12",
      "secret_name": "BREVO_API_KEY"
    }
  ],
  "observability": {
    "enabled": true
  }
}
